#!/bin/bash
#
# Startskript des Plugins — wird beim Systemstart von LoxBerry ausgefuehrt.
# Laeuft als root und muss schnell zurueckkehren.

PLUGINDIR=$(grep -A5 "^\[$PLUGINNAME\]" /data/system/plugindatabase.json 2>/dev/null \
            | grep -m1 '"directories"' | cut -d'"' -f4)
[ -z "$PLUGINDIR" ] && PLUGINDIR="echargeocpp"

SKRIPT="$LBHOMEDIR/bin/plugins/$PLUGINDIR/dienst.sh"

if [ -x "$SKRIPT" ]; then
    # Im Hintergrund: Das Skript wartet auf freie Ports und wuerde den
    # Systemstart sonst um einige Sekunden aufhalten.
    ( "$SKRIPT" start >/dev/null 2>&1 ) &
    /usr/bin/logger "eCharge@Home OCPP: Start eingeleitet"
else
    /usr/bin/logger "eCharge@Home OCPP: $SKRIPT fehlt"
fi

exit 0
