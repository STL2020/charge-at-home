#!/bin/bash
#
# Prueft alle fuenf Minuten, ob der Dienst laeuft, und startet ihn sonst.
#
# Damit muss niemand eine Konsole oeffnen: Faellt der Dienst aus — nach
# einem Absturz, einem belegten Port oder weil die Installation ihn nicht
# starten konnte —, laeuft er spaetestens fuenf Minuten spaeter wieder.
#
# Ausgabe unterdrueckt: Ein Cron-Job, der bei jedem Lauf schreibt, fuellt
# nur das Systemprotokoll.

# Der Cron-Job liegt in <plugin>/cron/, das Skript eine Ebene darüber.
VERZEICHNIS="$LBHOMEDIR/bin/plugins/$(basename "$(dirname "$(dirname "$0")")")"
[ -d "$VERZEICHNIS" ] || VERZEICHNIS="$LBHOMEDIR/bin/plugins/echargeocpp"
SKRIPT="$VERZEICHNIS/dienst.sh"

[ -x "$SKRIPT" ] || exit 0

if ! "$SKRIPT" status >/dev/null 2>&1; then
    "$SKRIPT" start >/dev/null 2>&1
    /usr/bin/logger "eCharge@Home OCPP: Dienst war gestoppt, neu gestartet"
fi

exit 0
